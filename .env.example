# ATLASCLOUD_API_KEY: Required for AtlasCloud dots-studio/dots-3-note-prev-free API.
# Get from https://console.atlascloud.ai
ATLASCLOUD_API_KEY="your-atlascloud-api-key"

# AGENTMAIL_API_KEY: Required for AgentMail API (https://docs.agentmail.to)
AGENTMAIL_API_KEY="your-agentmail-api-key"

# DATABASE_URL: Required for server-side fleet operations and persistence.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# DEFAULT_INBOX: Default AgentMail inbox address to watch (e.g. moms@agentmail.to)
DEFAULT_INBOX="moms@agentmail.to"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEON_DATA_API_URL: Data API REST endpoint
VITE_NEON_DATA_API_URL="https://ep-sparkling-pine-afqf3sia.apirest.c-2.us-west-2.aws.neon.tech/neondb/rest/v1"
NEON_DATA_API_URL="https://ep-sparkling-pine-afqf3sia.apirest.c-2.us-west-2.aws.neon.tech/neondb/rest/v1"

# NEON_AUTH_URL: Neon Auth endpoint
VITE_NEON_AUTH_URL="https://ep-sparkling-pine-afqf3sia.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth"
NEON_AUTH_URL="https://ep-sparkling-pine-afqf3sia.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth"
# Google OAuth (one client grants Gmail + Calendar access)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
